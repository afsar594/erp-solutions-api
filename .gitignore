################################################################################
# .gitignore for Inspire.Erp Solution
# Automatically created and optimized for Microsoft(R) Visual Studio projects.
################################################################################

# User-specific files
.vs/
*.user
*.suo

# Build results
**/bin/
**/obj/

# NuGet
*.nupkg
*.snupkg
*.nuspec
project.lock.json
project.fragment.lock.json
artifacts/
*.nuget.props
*.nuget.dgspec.json
*.nuget.targets

# Visual Studio generated files
*.pidb
*.sdf
*.cache
*.dbmdl
*.pdb
*.opendb

# ASP.NET publish profiles
**/Properties/PublishProfiles/

# Logs and uploads
/Inspire.Erp.Web/Logs/
/Inspire.Erp.Web/Upload/Pdfs/
/Inspire.Erp.Web/Upload/files/

# Configuration files
/Inspire.Erp.Web/appsettings.json

# Report and temporary files
/Inspire.Erp.WebReport/reports/
/Inspire.Erp.WebReport/Inspire.Erp.WebReport.csproj.user

# Ignore RecurringJob build output
/Inspire.Erp.RecurringJob/bin/
/Inspire.Erp.RecurringJob/obj/

# EditorConfig files generated during build
*.GeneratedMSBuildEditorConfig.editorconfig

# Cache and dependency tracking files
*.AssemblyReference.cache
*.assets.cache
*.project.nuget.cache
*.project.assets.json
